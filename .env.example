# Copy this file to .env for local Docker testing.
# Never commit real secrets.
SESSION_SECRET=mountain-hut-local-development-secret
SEED_DEMO_ACCOUNTS=true
TEST_HIKER_EMAIL=hiker@example.com
TEST_HIKER_PASSWORD=HikerTest123!
EMAIL_TEST_HIKER_EMAIL=delivered@resend.dev
EMAIL_TEST_HIKER_PASSWORD=EmailTest123!

# Resend test sender. Use delivered@resend.dev as the hiker email for testing.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Mountain Hut <onboarding@resend.dev>"
