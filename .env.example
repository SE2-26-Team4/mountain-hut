# This is a public configuration template. The team provides mountain-hut.env for deployment.

# Use the session secret provided by the team in mountain-hut.env.
SESSION_SECRET=replace-with-session-secret

# Demo accounts for signing in and testing the application.
SEED_DEMO_ACCOUNTS=true
TEST_HIKER_EMAIL=hiker@example.com
TEST_HIKER_PASSWORD=HikerTest123!
TEST_EMPLOYEE_EMAIL=employee@example.com
TEST_EMPLOYEE_PASSWORD=EmployeeTest123!

# Email delivery. Supply the valid Resend API key provided by the team in mountain-hut.env.
# To check receipt, use a hiker account with an inbox you can access.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Mountain Hut <mountain-hut@azeca.it>
