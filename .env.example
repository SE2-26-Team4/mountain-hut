# Copy this file to an external secrets file, for example ./mountain-hut.env.
# The Docker image and Compose do not contain these values.
# Never commit real secrets.
SESSION_SECRET=mountain-hut-local-development-secret
SEED_DEMO_ACCOUNTS=true
TEST_HIKER_EMAIL=hiker@example.com
TEST_HIKER_PASSWORD=HikerTest123!

# Resend test sender. Use delivered@resend.dev as the hiker email for testing.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Mountain Hut <mountain-hut@azeca.it>
