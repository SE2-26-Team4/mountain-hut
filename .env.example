# Copy this template to .env and configure it for your deployment.
# Keep .env private.

# Replace the placeholder with a long, random secret used to sign session cookies.
SESSION_SECRET=replace-with-session-secret

# Set to true to create the demo accounts with the credentials below.
SEED_DEMO_ACCOUNTS=true
TEST_HIKER_EMAIL=hiker@example.com
TEST_HIKER_PASSWORD=HikerTest123!
TEST_EMPLOYEE_EMAIL=employee@example.com
TEST_EMPLOYEE_PASSWORD=EmployeeTest123!

# To enable email delivery, supply a valid Resend API key and a sender address
# from a domain verified in your Resend account.
# To check receipt, use a hiker account with an inbox you can access.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Mountain Hut <mountain-hut@azeca.it>
